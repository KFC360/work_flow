# --- Compose 内 Web/Worker 连库用服务名 db（生产）---
DATABASE_URL=postgresql+psycopg://github_workflow:github_workflow@db:5432/github_workflow
# 本机进程直连 Compose 映射端口时改用：
# DATABASE_URL=postgresql+psycopg://github_workflow:github_workflow@127.0.0.1:55438/github_workflow

GITHUB_WEBHOOK_SECRET=
GITHUB_TOKEN=
GIT_AUTHOR_NAME=github-workflow
GIT_AUTHOR_EMAIL=github-workflow@localhost
APP_ADMIN_USER=admin
APP_ADMIN_PASSWORD=
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=360
DOC_TIMEOUT_SEC=900
CODE_TIMEOUT_SEC=1800
WORKTREE_ROOT=/var/lib/github-workflow/worktrees
# 邮件发件密码：只放环境变量，不写进 config.yaml；修改后需重启 Web / Worker
SMTP_PASSWORD=
# 生成代码时为代理创建临时库 gw_job_{id}（需 DB 角色有 CREATEDB）；失败则不注入 DATABASE_URL
AGENT_TEST_DB_ENABLED=true
CLAUDE_ARGS=
OPENCODE_ARGS=
# 可选：邮件里本应用 Issue 深链前缀，如 https://api.kfc360.xyz（不要尾斜杠）
APP_PUBLIC_BASE_URL=

# --- Docker Compose 插值 / Worker 挂载（生产）---
# 与部署用户一致，避免 worktree/git 属主错乱：id -u / id -g
HOST_UID=1000
HOST_GID=1000
HOST_HOME=/home/linuxuser
# 仓库工作副本父目录（页面 local_path 须落在此树下，容器内外路径相同）
REPOS_ROOT=/home/linuxuser/repos
