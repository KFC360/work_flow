DATABASE_URL=postgresql+psycopg://github_workflow:github_workflow@127.0.0.1:55438/github_workflow
GITHUB_WEBHOOK_SECRET=
GITHUB_TOKEN=
GIT_AUTHOR_NAME=github-workflow
GIT_AUTHOR_EMAIL=github-workflow@localhost
APP_ADMIN_USER=admin
APP_ADMIN_PASSWORD=
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=360
DOC_TIMEOUT_SEC=900
CODE_TIMEOUT_SEC=1800
WORKTREE_ROOT=/var/lib/github-workflow/worktrees
# 生成代码时为代理创建临时库 gw_job_{id}（需 DB 角色有 CREATEDB）；失败则不注入 DATABASE_URL
AGENT_TEST_DB_ENABLED=true
CLAUDE_ARGS=
OPENCODE_ARGS=
